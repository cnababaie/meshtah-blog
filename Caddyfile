meshtah.net {
    reverse_proxy next:3000

    # Optional: serve Strapi uploads directly (faster)
    handle_path /uploads/* {
        root * /strapi_uploads
        file_server
    }

    # API proxy
    handle /api/* {
        reverse_proxy strapi:1337
    }

    # Admin panel
    handle /admin* {
        reverse_proxy strapi:1337
    }
}

# If you have www → main domain redirect
www.meshtah.net {
    redir https://meshtah.net{uri}
}