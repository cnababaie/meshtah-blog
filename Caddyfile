meshtah.net {
    reverse_proxy next:3000

    handle_path /uploads/* {
        root * /strapi_uploads
        file_server
    }

    handle /api/* {
        reverse_proxy strapi:1337 {
            header_up Host {host}
            header_up X-Forwarded-Proto https

            header_down Set-Cookie ".*" "{http.reverse_proxy.header.Set-Cookie}; Domain=meshtah.net; Secure; SameSite=None"
        }
    }

    handle /admin* {
        reverse_proxy strapi:1337 {
            header_up Host {host}
            header_up X-Forwarded-Proto https

            header_down Set-Cookie ".*" "{http.reverse_proxy.header.Set-Cookie}; Domain=meshtah.net; Secure; SameSite=None"
        }
    }
}

www.meshtah.net {
    redir https://meshtah.net{uri}
}