meshtah.net {
    reverse_proxy next:3000

    handle_path /uploads/* {
        root * /strapi_uploads
        file_server
    }

    handle /api/* {
        reverse_proxy strapi:1337 {
            # Very important: rewrite Set-Cookie headers so cookies work on your real domain
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
            header_up Host {upstream_hostport}

            # Fix cookies: force domain and make them Secure + SameSite=None
            @cookie_set header_regexp Set-Cookie (.*)
            header @cookie_set Set-Cookie "{re.cookie_set.1}; Domain=meshtah.net; Path=/; Secure; SameSite=None"
        }
    }

    handle /admin* {
        reverse_proxy strapi:1337 {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
            header_up Host {upstream_hostport}

            @cookie_set header_regexp Set-Cookie (.*)
            header @cookie_set Set-Cookie "{re.cookie_set.1}; Domain=meshtah.net; Path=/; Secure; SameSite=None"
        }
    }
}

www.meshtah.net {
    redir https://meshtah.net{uri}
}