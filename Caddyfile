handle /api/* {
    reverse_proxy strapi:1337 {
        header_up Host {host}
        header_up X-Forwarded-Proto https

        header_down Set-Cookie ".*" "{http.reverse_proxy.header.Set-Cookie}; Secure; SameSite=None; Domain=meshtah.net"
    }
}

